<UserControl x:Class="Hermes_Executor.Views.ScriptEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:avalondit="http://icsharpcode.net/sharpdevelop/avalonedit"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="{DynamicResource BackgroundDark}">
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="25"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="{DynamicResource BackgroundLight}" Margin="10,5">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="5,0">
                <TextBlock Text="📝 Script • LUA" Foreground="{DynamicResource TextPrimary}" FontWeight="Bold" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="BtnExecute" Content="▶ EXECUTE" Width="90" Height="26" Background="{DynamicResource HermesGold}" Foreground="{DynamicResource BackgroundDark}" FontWeight="Bold" BorderThickness="0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="3">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Grid>

        <avalondit:TextEditor Grid.Row="1" x:Name="EditorControl"
                              Background="#121316" Foreground="#D4D4D4"
                              LineNumbersForeground="#6E7681"
                              FontFamily="Consolas" FontSize="13"
                              ShowLineNumbers="True"
                              Margin="10,0"/>

        <StatusBar Grid.Row="2" Background="Transparent" Foreground="{DynamicResource TextSecondary}">
            <StatusBarItem>
                <TextBlock x:Name="TxtEditorStatus" Text="Ln: 1 | Col: 1"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="UTF-8 | Lua"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</UserControl>
