<UserControl
    x:Class="Hermes_Executor.Views.ScriptHubView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>

        <!-- Hover border style for cards -->
        <Style x:Key="CardButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CardBorder"
                                Background="#1E1E22"
                                BorderBrush="#2E2E36"
                                BorderThickness="1"
                                CornerRadius="10"
                                ClipToBounds="True">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="10" ShadowDepth="2" Opacity="0.4"/>
                            </Border.Effect>
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="#FFD600"/>
                                <Setter TargetName="CardBorder" Property="Background" Value="#26262E"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CardBorder" Property="Background" Value="#2E2E3A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Action button style -->
        <Style x:Key="ActionBtnPrimary" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Background" Value="#FFD600"/>
            <Setter Property="Foreground" Value="#111111"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FFE640"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#C8AA00"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionBtnSecondary" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Background" Value="#2A2A32"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#36364A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#222230"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- SearchBox style -->
        <Style x:Key="SearchBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#1A1A20"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="CaretBrush" Value="#FFD600"/>
            <Setter Property="BorderBrush" Value="#333340"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#FFD600"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid Background="#13131A">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- SEARCH BAR -->
        <Border Grid.Row="0"
                Margin="12,12,12,8"
                Padding="10"
                Background="#1A1A22"
                CornerRadius="8"
                BorderBrush="#2A2A35"
                BorderThickness="1">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="110"/>
                </Grid.ColumnDefinitions>

                <TextBox
                    x:Name="SearchBox"
                    Height="36"
                    Style="{StaticResource SearchBoxStyle}"
                    KeyDown="SearchBox_KeyDown"/>

                <Button
                    Grid.Column="1"
                    x:Name="SearchButton"
                    Margin="10,0,0,0"
                    Height="36"
                    Content="🔍  SEARCH"
                    Style="{StaticResource ActionBtnPrimary}"
                    Click="SearchButton_Click"/>
            </Grid>
        </Border>

        <!-- RESULT SCROLL -->
        <ScrollViewer
            Grid.Row="1"
            Margin="12,0,12,12"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Disabled">

            <ItemsControl x:Name="ResultsList">

                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>

                        <Button
                            Width="210"
                            Height="215"
                            Margin="6"
                            Style="{StaticResource CardButtonStyle}"
                            Tag="{Binding}"
                            Click="ScriptCard_Click">

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="128"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- THUMBNAIL AREA -->
                                <Grid Grid.Row="0">
                                    <!-- Dark placeholder background -->
                                    <Border Background="#0D0D12" CornerRadius="10,10,0,0"/>

                                    <!-- Placeholder icon when no image -->
                                    <TextBlock
                                        Text="📜"
                                        FontSize="36"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Opacity="0.3"/>

                                    <!-- Actual image loaded via code-behind tag -->
                                    <Image
                                        x:Name="ThumbImg"
                                        Source="{Binding ThumbnailImage}"
                                        Stretch="UniformToFill"
                                        RenderOptions.BitmapScalingMode="HighQuality"/>

                                    <!-- Top gradient overlay for badges -->
                                    <Border CornerRadius="10,10,0,0">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#60000000" Offset="0"/>
                                                <GradientStop Color="#00000000" Offset="0.5"/>
                                                <GradientStop Color="#80000000" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>

                                    <!-- VIEWS badge - top left -->
                                    <Border
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        Margin="7,7,0,0"
                                        Padding="7,3"
                                        Background="#CC0D0D14"
                                        CornerRadius="10">
                                        <TextBlock
                                            Foreground="#DDDDDD"
                                            FontSize="10"
                                            FontWeight="Medium">
                                            <Run Text="◉ "/><Run Text="{Binding Views}"/>
                                        </TextBlock>
                                    </Border>

                                    <!-- PROVIDER badge - top right -->
                                    <Border
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Margin="0,7,7,0"
                                        Padding="7,3"
                                        Background="#CC0D0D14"
                                        CornerRadius="10">
                                        <TextBlock
                                            Text="{Binding Provider}"
                                            Foreground="#FFD600"
                                            FontSize="10"
                                            FontWeight="SemiBold"/>
                                    </Border>
                                </Grid>

                                <!-- INFO SECTION -->
                                <StackPanel
                                    Grid.Row="1"
                                    Margin="10,8,10,8"
                                    VerticalAlignment="Top">

                                    <TextBlock
                                        Text="{Binding Title}"
                                        Foreground="#EEEEEE"
                                        FontWeight="SemiBold"
                                        FontSize="12"
                                        TextWrapping="Wrap"
                                        MaxHeight="38"
                                        LineHeight="18"/>

                                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                        <TextBlock Text="🎮 " FontSize="10" Foreground="#888"/>
                                        <TextBlock
                                            Text="{Binding Game}"
                                            Foreground="#999999"
                                            FontSize="10"/>
                                    </StackPanel>

                                </StackPanel>

                            </Grid>

                        </Button>

                    </DataTemplate>
                </ItemsControl.ItemTemplate>

            </ItemsControl>

        </ScrollViewer>

        <!-- EMPTY STATE -->
        <StackPanel
            x:Name="EmptyState"
            Grid.Row="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Visibility="Collapsed">
            <TextBlock Text="🔍" FontSize="48" HorizontalAlignment="Center" Opacity="0.3"/>
            <TextBlock
                x:Name="EmptyStateText"
                Text="Ketik nama game atau script untuk mencari"
                Foreground="#555566"
                FontSize="13"
                Margin="0,12,0,0"
                HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- ACTION OVERLAY -->
        <Grid
            x:Name="ActionOverlay"
            Grid.RowSpan="2"
            Visibility="Collapsed"
            Background="#CC000000">

            <Border
                Width="440"
                Padding="20"
                Background="#1C1C24"
                BorderBrush="#3A3A48"
                BorderThickness="1"
                CornerRadius="12"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="30" ShadowDepth="0" Opacity="0.7"/>
                </Border.Effect>

                <StackPanel>

                    <!-- Header -->
                    <Grid Margin="0,0,0,14">
                        <TextBlock
                            x:Name="ActionTitle"
                            Text="Script"
                            Foreground="White"
                            FontSize="16"
                            FontWeight="Bold"
                            VerticalAlignment="Center"
                            Margin="0,0,35,0"
                            TextWrapping="Wrap"/>

                        <Button
                            Content="✕"
                            Width="30"
                            Height="30"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Foreground="#888"
                            Style="{StaticResource ActionBtnSecondary}"
                            Click="CloseAction_Click"/>
                    </Grid>

                    <!-- Thumbnail -->
                    <Border
                        Height="170"
                        Background="#0D0D12"
                        CornerRadius="8"
                        ClipToBounds="True">

                        <Grid>
                            <!-- Placeholder -->
                            <TextBlock
                                Text="📜"
                                FontSize="48"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Opacity="0.2"/>

                            <Image
                                x:Name="ActionThumbnail"
                                Stretch="UniformToFill"
                                RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Grid>

                    </Border>

                    <!-- Info -->
                    <TextBlock
                        x:Name="ActionGame"
                        Foreground="#FFD600"
                        FontWeight="SemiBold"
                        Margin="0,12,0,2"/>

                    <TextBlock
                        x:Name="ActionProvider"
                        Foreground="#666688"
                        FontSize="12"
                        Margin="0,0,0,16"/>

                    <!-- Execute -->
                    <Button
                        Margin="0,0,0,6"
                        Content="▶   EXECUTE SCRIPT"
                        Style="{StaticResource ActionBtnPrimary}"
                        Click="ExecuteSelected_Click"/>

                    <!-- Copy -->
                    <Button
                        Margin="0,0,0,6"
                        Content="📋   COPY TO CLIPBOARD"
                        Style="{StaticResource ActionBtnSecondary}"
                        Click="CopySelected_Click"/>

                    <!-- New tab -->
                    <Button
                        Content="＋   OPEN IN NEW TAB"
                        Style="{StaticResource ActionBtnSecondary}"
                        Click="OpenTabSelected_Click"/>

                </StackPanel>

            </Border>

        </Grid>

    </Grid>

</UserControl>