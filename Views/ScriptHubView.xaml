<UserControl
    x:Class="Hermes_Executor.Views.ScriptHubView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="#181818">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- SEARCH BAR -->
        <Border Grid.Row="0"
                Margin="10"
                Padding="8"
                Background="#202020"
                CornerRadius="4">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="100"/>
                </Grid.ColumnDefinitions>

                <TextBox
                    x:Name="SearchBox"
                    Height="32"
                    Padding="10,4"
                    Background="#252525"
                    Foreground="White"
                    BorderBrush="#444444"
                    VerticalContentAlignment="Center"
                    KeyDown="SearchBox_KeyDown"/>

                <Button
                    Grid.Column="1"
                    Margin="8,0,0,0"
                    Height="32"
                    Content="SEARCH"
                    Background="#FFD600"
                    Foreground="Black"
                    FontWeight="Bold"
                    Cursor="Hand"
                    Click="SearchButton_Click"/>
            </Grid>
        </Border>

        <!-- RESULT SCROLL -->
        <ScrollViewer
            Grid.Row="1"
            Margin="10,0,10,10"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Disabled">

            <ItemsControl
                x:Name="ResultsList">

                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>

                        <Button
                            Width="220"
                            Height="205"
                            Margin="6"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Tag="{Binding}"
                            Click="ScriptCard_Click">

                            <Border
                                Background="#202020"
                                BorderBrush="#303030"
                                BorderThickness="1"
                                CornerRadius="7"
                                ClipToBounds="True">

                                <Grid>

                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="125"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <!-- THUMBNAIL -->
                                    <Grid Grid.Row="0">

                                        <Border Background="#111111">
                                            <Image
                                                Source="{Binding ThumbnailUrl}"
                                                Stretch="UniformToFill"/>
                                        </Border>

                                        <!-- VIEWS -->
                                        <Border
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Margin="7"
                                            Padding="6,3"
                                            Background="#CC111111"
                                            CornerRadius="8">

                                            <TextBlock
                                                Foreground="White"
                                                FontSize="10">

                                                <Run Text="◉ "/>
                                                <Run Text="{Binding Views}"/>

                                            </TextBlock>

                                        </Border>

                                        <!-- PROVIDER -->
                                        <Border
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            Margin="7"
                                            Padding="6,3"
                                            Background="#CC111111"
                                            CornerRadius="8">

                                            <TextBlock
                                                Text="{Binding Provider}"
                                                Foreground="#FFD600"
                                                FontSize="10"/>
                                        </Border>

                                    </Grid>

                                    <!-- INFO -->
                                    <StackPanel
                                        Grid.Row="1"
                                        Margin="8,7">

                                        <TextBlock
                                            Text="{Binding Title}"
                                            Foreground="White"
                                            FontWeight="SemiBold"
                                            FontSize="12"
                                            TextWrapping="Wrap"
                                            MaxHeight="36"/>

                                        <TextBlock
                                            Text="{Binding Game}"
                                            Foreground="#888888"
                                            FontSize="11"
                                            Margin="0,5,0,0"/>

                                    </StackPanel>

                                </Grid>

                            </Border>

                        </Button>

                    </DataTemplate>
                </ItemsControl.ItemTemplate>

            </ItemsControl>

        </ScrollViewer>


        <!-- ACTION OVERLAY -->
        <Grid
            x:Name="ActionOverlay"
            Grid.RowSpan="2"
            Visibility="Collapsed"
            Background="#B8000000">

            <Border
                Width="430"
                Padding="18"
                Background="#202020"
                BorderBrush="#444444"
                BorderThickness="1"
                CornerRadius="8"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

                <StackPanel>

                    <!-- Header -->
                    <Grid Margin="0,0,0,12">

                        <TextBlock
                            x:Name="ActionTitle"
                            Text="Script"
                            Foreground="White"
                            FontSize="16"
                            FontWeight="Bold"
                            VerticalAlignment="Center"
                            Margin="0,0,35,0"
                            TextWrapping="Wrap"/>

                        <Button
                            Content="✕"
                            Width="28"
                            Height="28"
                            HorizontalAlignment="Right"
                            Background="Transparent"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="CloseAction_Click"/>
                    </Grid>

                    <!-- Thumbnail -->
                    <Border
                        Height="160"
                        Background="#111111"
                        CornerRadius="5"
                        ClipToBounds="True">

                        <Image
                            x:Name="ActionThumbnail"
                            Stretch="UniformToFill"/>

                    </Border>

                    <!-- Info -->
                    <TextBlock
                        x:Name="ActionGame"
                        Foreground="#FFD600"
                        Margin="0,10,0,0"/>

                    <TextBlock
                        x:Name="ActionProvider"
                        Foreground="#888888"
                        Margin="0,3,0,15"/>

                    <!-- Execute -->
                    <Button
                        Height="38"
                        Margin="0,3"
                        Content="▶  EXECUTE"
                        Background="#FFD600"
                        Foreground="Black"
                        FontWeight="Bold"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="ExecuteSelected_Click"/>

                    <!-- Copy -->
                    <Button
                        Height="38"
                        Margin="0,5,0,0"
                        Content="📋  COPY TO CLIPBOARD"
                        Background="#303030"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="CopySelected_Click"/>

                    <!-- New tab -->
                    <Button
                        Height="38"
                        Margin="0,5,0,0"
                        Content="＋  OPEN IN NEW TAB"
                        Background="#303030"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="OpenTabSelected_Click"/>

                </StackPanel>

            </Border>

        </Grid>

    </Grid>

</UserControl>