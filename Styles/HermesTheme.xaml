<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Hermes Theme Colors -->
    <SolidColorBrush x:Key="HermesGold" Color="#FFD700"/>
    <SolidColorBrush x:Key="HermesGoldDark" Color="#C0A000"/>
    <SolidColorBrush x:Key="HermesGoldLight" Color="#FFE44D"/>
    <SolidColorBrush x:Key="BackgroundDark" Color="#0D0D0D"/>
    <SolidColorBrush x:Key="BackgroundLight" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="BackgroundMedium" Color="#2D2D2D"/>
    <SolidColorBrush x:Key="TextPrimary" Color="#F0F0F0"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#A0A0A0"/>
    <SolidColorBrush x:Key="SuccessGreen" Color="#00FF00"/>
    <SolidColorBrush x:Key="ErrorRed" Color="#FF4444"/>
    <SolidColorBrush x:Key="WarningYellow" Color="#FFAA00"/>
</ResourceDictionary>
