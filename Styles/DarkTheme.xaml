<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="WindowBackground" Color="#0D0D0D"/>
    <SolidColorBrush x:Key="ControlBackground" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="ControlBackgroundHover" Color="#2D2D2D"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#333333"/>
    <SolidColorBrush x:Key="ForegroundPrimary" Color="#F0F0F0"/>
    <SolidColorBrush x:Key="ForegroundSecondary" Color="#A0A0A0"/>
</ResourceDictionary>
