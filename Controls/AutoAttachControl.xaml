<UserControl x:Class="Hermes_Executor.Controls.AutoAttachControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <Border Background="#1A1A1A" CornerRadius="8" Padding="12">
        <StackPanel>
            <!-- Header -->
            <Grid Margin="0,0,0,10">
                <TextBlock Text="⚡ Auto-Attach" 
                           Foreground="#FFD700"
                           FontWeight="Bold"
                           FontSize="14"/>
                <ToggleButton x:Name="AutoAttachToggle"
                              HorizontalAlignment="Right"
                              Width="50" Height="24"
                              Background="#2D2D2D"
                              Foreground="#A0A0A0"
                              Checked="AutoAttach_Checked"
                              Unchecked="AutoAttach_Unchecked">
                    <ToggleButton.Resources>
                        <Style TargetType="ToggleButton">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="#2D2D2D" CornerRadius="12">
                                            <Border x:Name="ToggleIndicator" 
                                                    Background="#FF4444" 
                                                    CornerRadius="10"
                                                    Width="20" Height="20"
                                                    HorizontalAlignment="Left"
                                                    Margin="2">
                                                <Border.Triggers>
                                                    <EventTrigger RoutedEvent="ToggleButton.Checked">
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <ThicknessAnimation Storyboard.TargetName="ToggleIndicator"
                                                                                   Storyboard.TargetProperty="Margin"
                                                                                   From="2,2" To="28,2"
                                                                                   Duration="0:0:0.2"/>
                                                                <ColorAnimation Storyboard.TargetName="ToggleIndicator"
                                                                                Storyboard.TargetProperty="Background.Color"
                                                                                From="#FF4444" To="#00FF44"
                                                                                Duration="0:0:0.2"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </EventTrigger>
                                                    <EventTrigger RoutedEvent="ToggleButton.Unchecked">
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <ThicknessAnimation Storyboard.TargetName="ToggleIndicator"
                                                                                   Storyboard.TargetProperty="Margin"
                                                                                   From="28,2" To="2,2"
                                                                                   Duration="0:0:0.2"/>
                                                                <ColorAnimation Storyboard.TargetName="ToggleIndicator"
                                                                                Storyboard.TargetProperty="Background.Color"
                                                                                From="#00FF44" To="#FF4444"
                                                                                Duration="0:0:0.2"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </EventTrigger>
                                                </Border.Triggers>
                                            </Border>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ToggleButton.Resources>
                </ToggleButton>
            </Grid>

            <!-- Status Indicator -->
            <Border x:Name="StatusIndicator" 
                    CornerRadius="8" 
                    Padding="10"
                    Background="#1A1A1A"
                    BorderThickness="1"
                    BorderBrush="#2D2D2D"
                    Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Ellipse x:Name="StatusDot" 
                             Grid.Column="0"
                             Width="14" Height="14" 
                             Fill="#FF4444"
                             Margin="0,0,10,0">
                        <Ellipse.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         From="1" To="0.3"
                                                         Duration="0:0:1"
                                                         AutoReverse="True"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>

                    <StackPanel Grid.Column="1">
                        <TextBlock x:Name="StatusText" 
                                   Text="OFFLINE" 
                                   Foreground="#FF4444"
                                   FontWeight="Bold"
                                   FontSize="13"/>
                        <TextBlock x:Name="StatusDetail" 
                                   Text="Menunggu Roblox..." 
                                   Foreground="#A0A0A0"
                                   FontSize="11"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Action Buttons -->
            <Grid Margin="0,5,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" 
                        x:Name="InjectButton"
                        Content="⚡ INJECT" 
                        Background="#FFD700"
                        Foreground="Black"
                        FontWeight="Bold"
                        Padding="10,8"
                        Margin="0,0,5,0"
                        Click="InjectButton_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button Grid.Column="1" 
                        x:Name="KillRobloxButton"
                        Content="🛑 KILL" 
                        Background="#FF4444"
                        Foreground="White"
                        FontWeight="Bold"
                        Padding="10,8"
                        Margin="5,0,0,0"
                        Click="KillRoblox_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- Instance Info -->
            <Border Background="#2D2D2D" 
                    CornerRadius="4" 
                    Padding="8"
                    Margin="0,10,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="🖥️" 
                               Foreground="#FFD700"
                               FontSize="14"
                               Margin="0,0,10,0"/>
                    
                    <TextBlock x:Name="InstanceInfo"
                               Grid.Column="1"
                               Text="No instance detected" 
                               Foreground="#A0A0A0"
                               FontSize="11"/>
                </Grid>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
