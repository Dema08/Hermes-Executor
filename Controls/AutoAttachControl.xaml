<UserControl x:Class="Hermes_Executor.Controls.AutoAttachControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <Border Background="#1A1A1A" CornerRadius="8" Padding="12">
        <StackPanel>
            <!-- Header -->
            <Grid Margin="0,0,0,10">
                <TextBlock Text="⚡ Auto-Attach" 
                           Foreground="#FFD700"
                           FontWeight="Bold"
                           FontSize="14"/>
                <ToggleButton x:Name="AutoAttachToggle"
                              HorizontalAlignment="Right"
                              Width="52" Height="26"
                              Background="#2D2D2D"
                              Foreground="#A0A0A0"
                              ToolTip="Klik untuk mengaktifkan/menonaktifkan Auto-Attach"
                              Checked="AutoAttach_Checked"
                              Unchecked="AutoAttach_Unchecked">
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="SwitchBorder" Background="#222222" BorderBrush="#3D3D3D" BorderThickness="1" CornerRadius="13" Cursor="Hand">
                                <Grid>
                                    <!-- Background Track Color Indicator -->
                                    <Border x:Name="TrackBg" Background="#FF4444" CornerRadius="12" Opacity="0.2"/>
                                    <Border x:Name="ToggleIndicator" 
                                            Background="#FF4444" 
                                            CornerRadius="10"
                                            Width="20" Height="20"
                                            HorizontalAlignment="Left"
                                            Margin="2">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.3" Color="Black"/>
                                        </Border.Effect>
                                    </Border>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="ToggleIndicator" Property="HorizontalAlignment" Value="Right"/>
                                    <Setter TargetName="ToggleIndicator" Property="Background" Value="#FFD700"/>
                                    <Setter TargetName="TrackBg" Property="Background" Value="#FFD700"/>
                                    <Setter TargetName="TrackBg" Property="Opacity" Value="0.3"/>
                                    <Setter TargetName="SwitchBorder" Property="BorderBrush" Value="#FFD700"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="SwitchBorder" Property="BorderBrush" Value="#FFE44D"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </ToggleButton.Template>
                </ToggleButton>
            </Grid>

            <!-- Status Indicator -->
            <Border x:Name="StatusIndicator" 
                    CornerRadius="8" 
                    Padding="10"
                    Background="#1A1A1A"
                    BorderThickness="1"
                    BorderBrush="#2D2D2D"
                    Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Ellipse x:Name="StatusDot" 
                             Grid.Column="0"
                             Width="14" Height="14" 
                             Fill="#FF4444"
                             Margin="0,0,10,0">
                        <Ellipse.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         From="1" To="0.3"
                                                         Duration="0:0:1"
                                                         AutoReverse="True"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>

                    <StackPanel Grid.Column="1">
                        <TextBlock x:Name="StatusText" 
                                   Text="OFFLINE" 
                                   Foreground="#FF4444"
                                   FontWeight="Bold"
                                   FontSize="13"/>
                        <TextBlock x:Name="StatusDetail" 
                                   Text="Menunggu Roblox..." 
                                   Foreground="#A0A0A0"
                                   FontSize="11"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Action Buttons -->
            <Grid Margin="0,5,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" 
                        x:Name="InjectButton"
                        Content="💉 INJECT" 
                        Background="#FFD700"
                        Foreground="Black"
                        FontWeight="Bold"
                        Padding="10,8"
                        Margin="0,0,5,0"
                        ToolTip="Pilih untuk melakukan Inject script engine ke dalam proses Roblox"
                        Click="InjectButton_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal"/>
                                        <VisualState x:Name="MouseOver">
                                            <Storyboard>
                                                <ColorAnimation Storyboard.TargetName="border"
                                                                Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                To="#FFE44D" Duration="0:0:0.15"/>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <ColorAnimation Storyboard.TargetName="border"
                                                                Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                To="#C0A000" Duration="0:0:0.1"/>
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button Grid.Column="1" 
                        x:Name="KillRobloxButton"
                        Content="🚫 KILL " 
                        Background="#2A2A2A"
                        Foreground="#FFD700"
                        BorderBrush="#FFD700"
                        BorderThickness="1"
                        FontWeight="Bold"
                        Padding="10,8"
                        Margin="5,0,0,0"
                        ToolTip="Pilih untuk menutup paksa proses Roblox (Kill)"
                        Click="KillRoblox_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal"/>
                                        <VisualState x:Name="MouseOver">
                                            <Storyboard>
                                                <ColorAnimation Storyboard.TargetName="border"
                                                                Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                To="#3A3A3A" Duration="0:0:0.15"/>
                                                <ColorAnimation Storyboard.TargetName="border"
                                                                Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                                To="#FFE44D" Duration="0:0:0.15"/>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <ColorAnimation Storyboard.TargetName="border"
                                                                Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                To="#202020" Duration="0:0:0.1"/>
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- Instance Info -->
            <Border Background="#2D2D2D" 
                    CornerRadius="4" 
                    Padding="8"
                    Margin="0,10,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="🖥️" 
                               Foreground="#FFD700"
                               FontSize="14"
                               Margin="0,0,10,0"/>
                    
                    <TextBlock x:Name="InstanceInfo"
                               Grid.Column="1"
                               Text="No instance detected" 
                               Foreground="#A0A0A0"
                               FontSize="11"/>
                </Grid>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
