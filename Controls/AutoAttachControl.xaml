<UserControl x:Class="Hermes_Executor.Controls.AutoAttachControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ClipToBounds="True">
    
    <Border Background="#1F1F25" 
            BorderBrush="#2E2E36" 
            BorderThickness="1" 
            CornerRadius="12" 
            Padding="14" 
            Margin="8"
            MinWidth="220" 
            MaxWidth="380" 
            Width="Auto" 
            HorizontalAlignment="Stretch">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="8" ShadowDepth="2" Opacity="0.2"/>
        </Border.Effect>
        <StackPanel>
            <!-- Header -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Grid.Column="0" 
                           Text="⚡ Auto-Attach" 
                           Foreground="#FFD700"
                           FontWeight="Bold"
                           FontSize="14"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
                           
                <ToggleButton Grid.Column="1" 
                               x:Name="AutoAttachToggle"
                               HorizontalAlignment="Right"
                               Width="52" Height="26"
                               Background="#2D2D2D"
                               Foreground="#A0A0A0"
                               ToolTip="Klik untuk mengaktifkan/menonaktifkan Auto-Attach"
                               Checked="AutoAttach_Checked"
                               Unchecked="AutoAttach_Unchecked">
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="SwitchBorder" Background="#222222" BorderBrush="#3D3D3D" BorderThickness="1" CornerRadius="13" Cursor="Hand">
                                <Grid>
                                    <!-- Background Track Color Indicator -->
                                    <Border x:Name="TrackBg" Background="#FF4444" CornerRadius="12" Opacity="0.2"/>
                                    <Border x:Name="ToggleIndicator" 
                                            Background="#FF4444" 
                                            CornerRadius="10"
                                            Width="20" Height="20"
                                            HorizontalAlignment="Left"
                                            Margin="2">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.3" Color="Black"/>
                                        </Border.Effect>
                                    </Border>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="ToggleIndicator" Property="HorizontalAlignment" Value="Right"/>
                                    <Setter TargetName="ToggleIndicator" Property="Background" Value="#FFD700"/>
                                    <Setter TargetName="TrackBg" Property="Background" Value="#FFD700"/>
                                    <Setter TargetName="TrackBg" Property="Opacity" Value="0.3"/>
                                    <Setter TargetName="SwitchBorder" Property="BorderBrush" Value="#FFD700"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="SwitchBorder" Property="BorderBrush" Value="#FFE44D"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </ToggleButton.Template>
                </ToggleButton>
            </Grid>

            <!-- Status Indicator (Height = 60) -->
            <Border x:Name="StatusIndicator" 
                    CornerRadius="8" 
                    Padding="12,0"
                    Background="{DynamicResource BackgroundDark}"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource BorderBrush}"
                    Margin="0,0,0,12"
                    Height="60">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Ellipse x:Name="StatusDot" 
                             Grid.Column="0"
                             Width="14" Height="14" 
                             Fill="#FF4444"
                             Margin="0,0,10,0">
                        <Ellipse.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         From="1" To="0.3"
                                                         Duration="0:0:1"
                                                         AutoReverse="True"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="StatusText" 
                                   Text="OFFLINE" 
                                   Foreground="#FF4444"
                                   FontWeight="Bold"
                                   FontSize="13"
                                   TextWrapping="Wrap"/>
                        <TextBlock x:Name="StatusDetail" 
                                   Text="Menunggu Roblox..." 
                                   Foreground="#A0A0A0"
                                   FontSize="11"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Action Buttons Wrap Panel -->
            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                <Button x:Name="InjectButton"
                        Content="💉 INJECT" 
                        Background="#FFD700"
                        Foreground="Black"
                        FontWeight="Bold"
                        Width="105"
                        Height="36"
                        Margin="4"
                        ToolTip="Pilih untuk melakukan Inject script engine ke dalam proses Roblox"
                        Click="InjectButton_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal"/>
                                        <VisualState x:Name="MouseOver">
                                            <Storyboard>
                                                <ColorAnimation Storyboard.TargetName="border"
                                                                Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                To="#FFE44D" Duration="0:0:0.15"/>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <ColorAnimation Storyboard.TargetName="border"
                                                                Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                To="#C0A000" Duration="0:0:0.1"/>
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button x:Name="KillRobloxButton"
                        Content="🚫 KILL " 
                        Background="{DynamicResource BackgroundLight}"
                        Foreground="{DynamicResource HermesGold}"
                        BorderBrush="{DynamicResource HermesGold}"
                        BorderThickness="1"
                        FontWeight="Bold"
                        Width="105"
                        Height="36"
                        Margin="4"
                        ToolTip="Pilih untuk menutup paksa proses Roblox (Kill)"
                        Click="KillRoblox_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal"/>
                                        <VisualState x:Name="MouseOver">
                                            <Storyboard>
                                                <ColorAnimation Storyboard.TargetName="border"
                                                                Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                To="#3A3A3A" Duration="0:0:0.15"/>
                                                <ColorAnimation Storyboard.TargetName="border"
                                                                Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                                To="#FFE44D" Duration="0:0:0.15"/>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <ColorAnimation Storyboard.TargetName="border"
                                                                Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                To="#202020" Duration="0:0:0.1"/>
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </WrapPanel>

            <!-- Instance Info (Height = 36) -->
            <Border Background="{DynamicResource BackgroundDark}" 
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6" 
                    Padding="10,0"
                    Margin="0,12,0,0"
                    Height="36">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="🖥️" 
                               Foreground="#FFD700"
                               FontSize="14"
                               Margin="0,0,10,0"
                               VerticalAlignment="Center"/>
                    
                    <TextBlock x:Name="InstanceInfo"
                               Grid.Column="1"
                               Text="No instance detected" 
                               Foreground="#A0A0A0"
                               FontSize="11"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                </Grid>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
