<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Hermes Theme Accent Colors -->
    <SolidColorBrush x:Key="HermesGold" Color="#FFD700"/>
    <SolidColorBrush x:Key="HermesGoldDark" Color="#C0A000"/>
    <SolidColorBrush x:Key="HermesGoldLight" Color="#FFE44D"/>
    
    <!-- Backgrounds -->
    <SolidColorBrush x:Key="BackgroundDark" Color="#18181C"/>
    <SolidColorBrush x:Key="BackgroundLight" Color="#232329"/>
    <SolidColorBrush x:Key="BackgroundMedium" Color="#1D1D22"/>
    
    <!-- Text Colors -->
    <SolidColorBrush x:Key="TextPrimary" Color="#F5F5F7"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#B0B0BA"/>
    <SolidColorBrush x:Key="TextMuted" Color="#6A6A75"/>
    
    <!-- Status colors -->
    <SolidColorBrush x:Key="SuccessGreen" Color="#00FF00"/>
    <SolidColorBrush x:Key="ErrorRed" Color="#FF4444"/>
    <SolidColorBrush x:Key="WarningYellow" Color="#FFAA00"/>
    
    <!-- Controls borders & specifics -->
    <SolidColorBrush x:Key="BorderBrush" Color="#2A2A33"/>
    <SolidColorBrush x:Key="WindowBackground" Color="#18181C"/>
    <SolidColorBrush x:Key="ControlBackground" Color="#232329"/>
    <SolidColorBrush x:Key="ControlBackgroundHover" Color="#2E2E36"/>
    
    <!-- Tab states -->
    <SolidColorBrush x:Key="TabActive" Color="#18181C"/>
    <SolidColorBrush x:Key="TabInactive" Color="#232329"/>
    
    <!-- Inputs & output panel specifics -->
    <SolidColorBrush x:Key="InputBackground" Color="#121215"/>
    <SolidColorBrush x:Key="ConsoleBackground" Color="#121215"/>
</ResourceDictionary>
