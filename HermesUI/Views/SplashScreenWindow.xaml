<Window x:Class="Hermes_Executor.Views.SplashScreenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Hermes Executor - Loading" Height="480" Width="760"
        Icon="pack://application:,,,/Controls/Resource/hermes_icon.ico"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True">

    <Window.Resources>
        <!-- Gentle Floating & Scale Animation Storyboard -->
        <Storyboard x:Key="HermesGentleFloatPulseStoryboard" RepeatBehavior="Forever" AutoReverse="True">
            <!-- Subtle Float / Bob (Melayang naik-turun 6px secara halus) -->
            <DoubleAnimation Storyboard.TargetName="HermesTranslateTransform"
                             Storyboard.TargetProperty="Y"
                             From="0" To="-6" Duration="0:0:2.2">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <!-- Subtle Scale (1.00 -> 1.03) -->
            <DoubleAnimation Storyboard.TargetName="HermesScaleTransform"
                             Storyboard.TargetProperty="ScaleX"
                             From="1.00" To="1.03" Duration="0:0:2.2">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="HermesScaleTransform"
                             Storyboard.TargetProperty="ScaleY"
                             From="1.00" To="1.03" Duration="0:0:2.2">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- Progress Bar Shimmer Animation -->
        <Storyboard x:Key="ShimmerStoryboard" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="ShimmerTransform"
                             Storyboard.TargetProperty="X"
                             From="-150" To="600" Duration="0:0:2.5">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Window.Resources>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard Storyboard="{StaticResource HermesGentleFloatPulseStoryboard}"/>
            <BeginStoryboard Storyboard="{StaticResource ShimmerStoryboard}"/>
        </EventTrigger>
    </Window.Triggers>

    <Grid x:Name="RootGrid" Opacity="0">
        <Grid.Triggers>
            <EventTrigger RoutedEvent="Grid.Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="RootGrid"
                                         Storyboard.TargetProperty="Opacity"
                                         From="0" To="1" Duration="0:0:0.6">
                            <DoubleAnimation.EasingFunction>
                                <QuadraticEase EasingMode="EaseOut"/>
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Grid.Triggers>

        <!-- Pure Pitch-Black Background (No Box Lines) -->
        <Border Margin="10" CornerRadius="12" BorderThickness="0" Background="#000000">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="25" ShadowDepth="0" Opacity="0.5"/>
            </Border.Effect>

            <!-- Content Layout -->
            <Grid Margin="40,30,40,25">
                <Grid.RowDefinitions>
                    <!-- Main Center Section: Dewa Hermes Vector + Title -->
                    <RowDefinition Height="*"/>
                    <!-- Bottom Section: Progress & Status -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- CENTER SECTION: Pure Dewa Hermes Vector (Cropped to exclude text, Smooth Blend) + Text -->
                <StackPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center">

                    <!-- Hermes Vector Container -->
                    <Grid Width="260" Height="200" HorizontalAlignment="Center" VerticalAlignment="Center">

                        <!-- Pure Dewa Hermes Figure (Viewbox cropped tight to exclude text from JPEG) -->
                        <Border Width="240" Height="190" 
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="HermesScaleTransform" CenterX="120" CenterY="95" ScaleX="1.0" ScaleY="1.0"/>
                                    <TranslateTransform x:Name="HermesTranslateTransform" Y="0"/>
                                </TransformGroup>
                            </Border.RenderTransform>

                            <Border.Background>
                                <ImageBrush ImageSource="pack://application:,,,/Controls/Resource/hermes_loadingscreen.jpg" 
                                            Stretch="Uniform" 
                                            Viewbox="0.16, 0.0, 0.68, 0.44" 
                                            ViewboxUnits="RelativeToBoundingBox"/>
                            </Border.Background>

                            <!-- Soft Radial Blend Mask: Fades out any JPEG background edges seamlessly into pure black -->
                            <Border.OpacityMask>
                                <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                                    <GradientStop Color="#FF000000" Offset="0.65"/>
                                    <GradientStop Color="#00000000" Offset="0.98"/>
                                </RadialGradientBrush>
                            </Border.OpacityMask>
                        </Border>
                    </Grid>

                    <!-- Text Typography Section -->
                    <StackPanel HorizontalAlignment="Center" Margin="0,15,0,0">
                        <TextBlock Text="HERMES EXECUTOR" 
                                   Foreground="{DynamicResource HermesGold}" 
                                   FontSize="24" 
                                   FontWeight="Bold" 
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="#FFD700" BlurRadius="8" ShadowDepth="0" Opacity="0.45"/>
                            </TextBlock.Effect>
                        </TextBlock>

                        <TextBlock Text="NEXT-GEN ROBLOX EXECUTION ENGINE" 
                                   Foreground="#8E8E98" 
                                   FontSize="10" 
                                   FontWeight="SemiBold" 
                                   HorizontalAlignment="Center" 
                                   TextAlignment="Center" 
                                   Margin="0,6,0,0" 
                                   Opacity="0.8"/>
                    </StackPanel>
                </StackPanel>

                <!-- BOTTOM SECTION: Minimalist Progress Bar & Loading Status -->
                <Grid Grid.Row="1" Margin="0,15,0,5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Loading Status Text (Left) & Percentage (Right) -->
                    <Grid Grid.Row="0" Margin="2,0,2,8">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <TextBlock Text="✦ " Foreground="{DynamicResource HermesGold}" FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtLoadingStatus" 
                                       Text="Initializing Hermes..." 
                                       Foreground="#D0D0D8" 
                                       FontSize="11" 
                                       FontFamily="Segoe UI" 
                                       FontWeight="Medium"/>
                        </StackPanel>

                        <TextBlock x:Name="TxtPercentage" 
                                   Text="0%" 
                                   Foreground="{DynamicResource HermesGold}" 
                                   FontSize="12" 
                                   FontWeight="Bold" 
                                   HorizontalAlignment="Right"/>
                    </Grid>

                    <!-- Minimalist Thin Progress Bar Track -->
                    <Border Grid.Row="1" Height="4" Background="#161619" CornerRadius="2" ClipToBounds="True">
                        <Grid x:Name="ProgressBarTrack">
                            <!-- Progress Bar Gold Fill -->
                            <Border x:Name="ProgressBarFill" HorizontalAlignment="Left" Width="0" CornerRadius="2">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#C0A000" Offset="0.0"/>
                                        <GradientStop Color="#FFD700" Offset="0.6"/>
                                        <GradientStop Color="#FFE44D" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>

                            <!-- Subtle Shimmer Highlight -->
                            <Rectangle Width="100" Height="4" HorizontalAlignment="Left" IsHitTestVisible="False">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#00FFFFFF" Offset="0.0"/>
                                        <GradientStop Color="#55FFFFFF" Offset="0.5"/>
                                        <GradientStop Color="#00FFFFFF" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                                <Rectangle.RenderTransform>
                                    <TranslateTransform x:Name="ShimmerTransform" X="-150"/>
                                </Rectangle.RenderTransform>
                            </Rectangle>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
