<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Hermes_Executor</RootNamespace>
    <ApplicationIcon>Controls\Resource\hermes_icon.ico</ApplicationIcon>
    <AssemblyTitle>Hermes Executor</AssemblyTitle>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Description>Hermes Roblox Executor - Premium UI</Description>
    <Company>Hermes-Team</Company>
    <Product>Hermes Executor</Product>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ModernWpfUI" Version="0.9.5" />
    <PackageReference Include="AvalonEdit" Version="6.3.0.90" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="FontAwesome.Sharp" Version="6.3.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Controls\Resource\hermes_loadingscreen.jpg" />
    <Resource Include="Controls\Resource\caduceus_logo.jpg" />
    <Resource Include="Controls\Resource\hermes_icon.ico" />
    <EmbeddedResource Include="Controls\Resource\LuaVSCode.xshd" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="**\*.xaml.cs">
      <DependentUpon>%(Filename)</DependentUpon>
    </Compile>
  </ItemGroup>
</Project>
